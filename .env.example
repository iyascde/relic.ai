# Relic.ai environment configuration
# Copy this file to .env and fill in real values to go live.
# With USE_MOCK_RESPONSES=true (the default), no API keys are needed.

# -- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# -- Pinecone -----------------------------------------------------------------
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=relic-ai-incidents

# -- GitHub -------------------------------------------------------------------
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_REPO_OWNER=YOUR_GITHUB_ORG_OR_USERNAME_HERE
GITHUB_REPO_NAME=YOUR_REPO_NAME_HERE
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# -- Flask --------------------------------------------------------------------
FLASK_PORT=5050
FLASK_DEBUG=false

# -- Relic.ai -----------------------------------------------------------------
# Set to false and fill in all API keys above to use real external services.
USE_MOCK_RESPONSES=true

# -- Database -----------------------------------------------------------------
DATABASE_PATH=./db/relic.db

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
